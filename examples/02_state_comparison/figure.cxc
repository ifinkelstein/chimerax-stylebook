# Example 02: three states of SpCas9, one orientation, one scale.
# Apo 4CMP, binary Cas9-sgRNA 4ZT0, R-loop 5F9R.
# Rule: superpose everything on one reference, set the view once, then
# render one PNG per state by hiding the others. Never re-frame between
# panels or the reader cannot compare them.
open 4cmp
open 4zt0
open 5f9r
open ../../palettes/lab_colors.cxc

# One protein copy per entry (chain IDs differ between entries).
delete #1/B
# 4CMP has two copies in the asymmetric unit; keep one
delete #2/C,D

# Superpose on the apo protein
matchmaker #2/A to #1/A
matchmaker #3/B to #1/A

open ../../presets/Base/publication_white.cxc

# Protein pale, nucleic acids saturated: the thing that changes gets the color
color #1/A lab_gray_p
color #2/A lab_gray_p
color #3/B lab_gray_p
color #2/B lab_sgrna
color #3/A lab_sgrna
color #3/C lab_target
color #3/D lab_nontarget

# Frame on the largest state so nothing is clipped in any panel
view #1/A|#2/A|#3/B
turn y 30
view #1/A|#2/A|#3/B pad 0.25

hide #2,3 models
2dlabels text "apo  4CMP" xpos 0.04 ypos 0.94 size 22 color lab_black bold true
save state1_apo.png width 1800 supersample 3

hide #1 models
show #2 models
2dlabels delete all
2dlabels text "binary  4ZT0" xpos 0.04 ypos 0.94 size 22 color lab_black bold true
save state2_binary.png width 1800 supersample 3

hide #2 models
show #3 models
2dlabels delete all
2dlabels text "R-loop  5F9R" xpos 0.04 ypos 0.94 size 22 color lab_black bold true
save state3_rloop.png width 1800 supersample 3
